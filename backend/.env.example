NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lifelink_dev?schema=public"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=lifelink-api
JWT_AUDIENCE=lifelink-clients
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# Development/demo-only admin bootstrap (npm run seed:admin --workspace=backend).
# Not read by the server itself; only used by prisma/seed-admin.ts. Never commit real values.
ADMIN_SEED_PHONE=+15550000001
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_DISPLAY_NAME=Development Admin
ADMIN_SEED_PASSWORD=replace-with-a-strong-local-password
