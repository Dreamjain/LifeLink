# Dedicated database for database-backed Vitest suites only. Never point this at lifelink_dev,
# production, or any database containing data that must be retained.
#
# Create the database manually, then set this variable in your shell or a local backend/.env.test
# file before running tests. The database name must end in _test; Vitest refuses any other name.
TEST_DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/lifelink_test?schema=public
